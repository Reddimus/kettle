# libFuzzer dictionary for the decoder's text: ffprobe's flat keys, a
# packet line's flags and a codec list's flags.
stream="streams.stream.0."
index="index="
video="codec_type=\"video\""
audio="codec_type=\"audio\""
codec="codec_name=\"h264\""
width="width="
height="height="
aspect="sample_aspect_ratio="
average="avg_frame_rate="
real="r_frame_rate="
time_base="time_base="
start="start_time="
duration="duration="
cover="disposition.attached_pic=1"
rotation="side_data_list.side_data.0.rotation="
format_start="format.start_time="
format_duration="format.duration="
na="N/A"
key=",K__"
discard=",_D_"
decoder=" DEV.LS "
separator="\x00"
audio_pts="packets.packet.0.pts_time="
audio_dts="packets.packet.0.dts_time="
