# libFuzzer dictionary for PDF pages: the header and trailer, object and
# stream syntax, cross-reference forms, and common content operators.
header="%PDF-1.7"
eof="%%EOF"
obj=" 0 obj"
endobj="endobj"
ref=" 0 R"
stream="stream\x0a"
endstream="\x0aendstream"
xref="xref"
trailer="trailer"
startxref="startxref"
dict_open="<<"
dict_close=">>"
type_catalog="/Type /Catalog"
type_pages="/Type /Pages"
type_page="/Type /Page"
type_objstm="/Type /ObjStm"
type_xref="/Type /XRef"
kids="/Kids"
count="/Count"
mediabox="/MediaBox"
cropbox="/CropBox"
rotate="/Rotate 90"
contents="/Contents"
length="/Length"
filter="/Filter /FlateDecode"
font="/Font"
resources="/Resources"
xobject="/XObject"
image="/Subtype /Image"
bt="BT"
et="ET"
tf="Tf"
tj="Tj"
re=" re"
fill=" f"
stroke=" S"
gsave="q"
grestore="Q"
cm=" cm"
rg=" rg"
clip=" W n"
