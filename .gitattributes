# Normalize line endings to LF for all text files so cross-platform builds and
# line-ending-sensitive `include_str!` drift tests are deterministic. The GitHub
# Windows runner checks out with `autocrlf`, which turned LF-committed source
# into CRLF and broke a multi-line `\n` source-scan drift test —
# the `build (windows-latest)` CI job had been red since v2.8.0 as a result.
* text=auto eol=lf

# Binary assets — never apply text / EOL conversion.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.mp4   binary
*.ico   binary
*.icns  binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.gz    binary
*.zip   binary

# Third-party license text kept byte for byte as upstream ships it, so its
# recorded SHA-256 still matches: the Fira Sans OFL uses CRLF.
assets/fonts/fira-sans/OFL.txt -text

# Upstream Mermaid fixtures kept byte for byte, so their recorded SHA-256 in
# the fixture README still match: two end without a final newline.
crates/kettle-media-render/tests/fixtures/mermaid/*.mmd -text
