# kettle config — Ghostty-compatible `key = value` syntax.
#
# Copy to $XDG_CONFIG_HOME/kettle/config (usually ~/.config/kettle/config on
# Linux/macOS, %APPDATA%\kettle\config on Windows). One entry per line; the
# first `=` separates key from value; surrounding whitespace is trimmed.
# FULL-LINE comments only — a `#` inside a value (e.g. a hex color) is
# part of that value, NOT the start of a trailing comment. Put any
# explanation on its own line.
# Some keys may repeat (`font-family`, `font-feature`, `palette`, `keybind`,
# `ssh-host`); the last occurrence wins unless noted "Repeatable".
#
# Validate with `kettle --check-config` (and `--list-keybinds` /
# `--list-themes` for the full enumerations). The reload chord re-reads it
# at runtime, warning on unknown keys and malformed values via stderr.
#
# Everything below is commented out so the defaults stand. Uncomment what
# you want to change.

# ─── Theme ────────────────────────────────────────────────────────────────
# Name from `kettle --list-themes` (~512 bundled — every Ghostty theme).
# theme = TokyoNight Night

# ─── Fonts ────────────────────────────────────────────────────────────────
# font-family = JetBrainsMono Nerd Font
# Per-style overrides (each falls back to `font-family` if unset):
# font-family-bold        = JetBrainsMono Nerd Font Bold
# font-family-italic      = JetBrainsMono Nerd Font Italic
# font-family-bold-italic = JetBrainsMono Nerd Font Bold Italic
# font-size = 13

# OpenType feature toggles. Repeatable; one feature per line or comma-list.
# Forms: `liga` / `+calt` / `-liga` / `liga off` / `cv01=2` / `ss05 3`.
# Toggling any liga/clig/calt/dlig feature also flips the global ligature
# shaper flag (off by default for speed; the toggle re-enables it).
# font-feature = liga
# font-feature = +calt
# font-feature = cv01=2

# ─── Window chrome ───────────────────────────────────────────────────────
# 0.0–1.0; <1.0 needs a compositor on Linux.
# background-opacity   = 1.0
# Gutter px around the content area.
# window-padding-x     = 8
# window-padding-y     = 8
# WCAG contrast ratio (0–21); 0 = off; 4.5 is the AA threshold.
# minimum-contrast     = 0.0

# Title templates. Placeholders:
#   {title}  active pane's OSC 2/0 title (else "kettle")
#   {cwd}    active pane's cwd basename (else empty)
#   {tab}    1-based active tab index
# window-title-format = {title} — kettle
# tab-format          = {n}: {title}

# ─── Tabs & splits ───────────────────────────────────────────────────────
# off | auto | always
# tab-bar              = always
# top | bottom
# tab-bar-position     = top
# Status bar (iTerm2 / kitty parity). Thin strip at the
# configured edge showing HH:MM:SS UTC · theme · focused pane title.
# off | top | bottom    aliases: none/false=off, on/true=bottom
# status-bar           = off
# 0.1–1.0; dim inactive panes.
# unfocused-split-opacity = 0.7
# Inactive border.
# split-divider-color  = #444444
# Active pane border.
# focused-split-color  = #7aa2f7

# ─── Cursor ──────────────────────────────────────────────────────────────
# block | underline | bar
# cursor-style          = block
# `false` disables blink.
# cursor-style-blink    = true
# Blink half-period in ms; 50–5000.
# cursor-blink-interval = 530
# cursor-color          = #f7768e

# ─── Bell ────────────────────────────────────────────────────────────────
# off | visual | attention | both
# bell = both

# ─── OSC 52 clipboard policy ─────────────────────────────────────────────
# How much of OSC 52 programs in the terminal can use.
# off | copy (writes only — default) | paste | both
# osc52 = copy

# ─── Selection & mouse ───────────────────────────────────────────────────
# copy-on-select        = true
# mouse-hide-while-typing = true
# Override the engine default; empty = engine default.
# word-delimiters       = ()[]{}<>
# selection-foreground  = #1a1b26
# selection-background  = #e0af68

# ─── Scrolling ───────────────────────────────────────────────────────────
# `0`/`infinite`/`unlimited` for the cap.
# scrollback              = 10000
# never | auto | always
# scrollbar               = auto
# Jump to bottom on next keystroke.
# scroll-on-keystroke     = true
# Jump to bottom when new output arrives.
# scroll-on-output        = false
# Mouse-wheel speed (0.1–50).
# scroll-multiplier       = 1.0
# Disable Ctrl+wheel font-size change. Keyboard chords still work.
# disable-mousewheel-zoom = false

# ─── Search overlay ──────────────────────────────────────────────────────
# search-foreground = #1a1b26
# search-background = #e0af68

# ─── Per-color overrides on top of the theme ─────────────────────────────
# background = #1a1b26
# foreground = #c0caf5
# Repeatable: `palette = N=#hex` where N is 0–15 (ANSI 16). Higher
# indices (16–255 xterm 256-color extension) are computed deterministically
# at render time and can be overridden at runtime via OSC 4 from a program,
# but aren't user-settable from the config today — `--check-config` flags
# `palette = N=...` with N ≥ 16 as out-of-range so a typo doesn't dis-
# appear silently.
# palette = 4=#7aa2f7
# palette = 12=#7aa2f7

# ─── Shell / startup command ─────────────────────────────────────────────
# `shell` is an accepted alias.
# command = /usr/bin/fish

# ─── SSH launcher (Ctrl+Shift+S) ─────────────────────────────────────────
# Repeatable. `name=user@host`; name is what shows in the launcher list.
# ssh-host = box=me@box.example.com
# ssh-host = work=wkennedy@bastion.work.example

# ─── Keybindings ─────────────────────────────────────────────────────────
# Full default set: `kettle --list-keybinds`. Override one with:
#   keybind = ctrl+shift+t = new_tab
# Remove a default (let the shell/another tool have the chord) with any of
# the unbind sentinels (`unbind` / `none` / `null` / `false` / empty):
#   keybind = ctrl+shift+c = unbind
# Action names — see docs/CONFIG.md for the full list. Examples:
# keybind = ctrl+shift+f = start_search
# keybind = alt+1        = goto_tab:1

# ─── Terminator-parity surface (cycles 331-410) ──────────────────────────
# kettle ships every documented Terminator config key. Both kebab-case
# (kettle convention) and underscore form (Terminator convention) are
# accepted for every key. See docs/TERMINATOR-AUDIT.md for the per-key
# audit.

# Window state at launch:
# window-state = maximise   # also: maximize | fullscreen | hidden | normal
# borderless = true         # hide OS chrome (winit set_decorations(false))
# always-on-top = true      # keep above other windows
# hide-on-lose-focus = true # Quake-style auto-hide (Wayland honors compositor)

# Per-pane titlebar (Terminator titlebar.py parity):
# show-titlebar = true      # default true; the bar renders when >1 pane
# title-at-bottom = false   # bar at top of pane (default) vs bottom
# title-hide-sizetext = false   # show "WxH" annotation in the titlebar
# icon-bell = true              # bell glyph in titlebar when ringing
# title-transmit-bg-color = #c80003  # focused-pane bar bg
# title-receive-bg-color  = #0076c9  # group-member-receiving bar bg
# title-inactive-bg-color = #c0bebf  # idle bar bg
# title-transmit-fg-color = #ffffff
# title-receive-fg-color  = #ffffff
# title-inactive-fg-color = #000000

# Background-image wallpaper (Terminator terminal.py parity):
# background-type = image       # solid (default) | transparent | image
# background-image = ~/Pictures/wallpaper.jpg
# background-image-mode = scale # stretch_and_fill (default) | tile | center | scale
# background-image-align-horiz = center  # left | center | right
# background-image-align-vert  = middle  # top | middle | bottom
# background-blur = true        # CPU-side 3-pass box blur at decode
# background-darkness = 0.5     # 0.0 = fully dark .. 1.0 = no tint

# Exit behavior on shell-exit (Terminator config.py):
# exit-action = close       # close (default) | restart | hold

# Mouse / paste behavior:
# link-single-click = true       # single-click opens URLs (default: Ctrl+click)
# disable-mouse-paste = true     # block middle-click paste
# putty-paste-style = true       # right-click pastes (PuTTY convention)

# Tab UX:
# close-button-on-tab = false    # hide ✕ on tab segments
# new-tab-after-current-tab = true   # insert vs append

# Lua plugin sandbox (~/.config/kettle/init.lua auto-loads):
# lua-sandbox = safe       # safe (default) nil's os.execute, io.open, etc.
# lua-sandbox = trusted    # full Lua stdlib access (opt-in)

# Accent color (peacock parity) — tint window chrome so
# multiple kettle windows are visually distinct. Hex or palette name.
# accent-color = #00d4ff

# Silence the bell entirely (Terminator force_no_bell parity).
# Overrides `bell` mode + the visual flash + tray attention.
# force-no-bell = true

# Output triggers — regex match on PTY output fires window urgency
# (taskbar/dock attention). Repeatable; `--check-config` reports
# invalid regexes at config-load time. v1 only ships the Urgency
# action — the value is the whole regex (do NOT add a second `=`
# separator).
# trigger = error:.*
# trigger = ssh: connect to host .* port .*: Connection refused
