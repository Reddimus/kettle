# kettle config — Ghostty-compatible `key = value` syntax.
#
# Config file location:
#   Linux / WSL :  ~/.config/kettle/config  (or $XDG_CONFIG_HOME/kettle/config)
#   macOS       :  ~/.config/kettle/config  (kettle uses XDG paths, not ~/Library)
#   Windows     :  %APPDATA%\kettle\config  (a stray HOME is ignored; set XDG_CONFIG_HOME for ~/.config)
# Run `kettle --config-path` to print the resolved path for this build,
# `kettle --print-default-config > <path-from-above>` to bootstrap.
#
# Syntax: one entry per line; the first `=` separates key from value;
# surrounding whitespace is trimmed.
# FULL-LINE comments only — a `#` inside a value (e.g. a hex color) is
# part of that value, NOT the start of a trailing comment. Put any
# explanation on its own line.
# Some keys may repeat (`font-family`, `font-feature`, `palette`, `keybind`,
# `ssh-host`); the last occurrence wins unless noted "Repeatable".
#
# Validate with `kettle --check-config` (and `--list-keybinds` /
# `--list-themes` for the full enumerations). The reload chord re-reads it
# at runtime, warning on unknown keys and malformed values via stderr.
#
# Everything below is commented out so the defaults stand. Uncomment what
# you want to change.
#
# ─── Quick-find index ─────────────────────────────────────────────────────
# Search this file for the keyword listed; each lands you near the
# block you want.
#   "─── Theme"           → theme = ...; also `--list-themes`
#   "─── Fonts"           → font-family, font-size, font-feature, ligature
#   "─── Cursor"          → cursor-style, cursor-blink, cursor-color
#   "─── Window chrome"   → padding, opacity, minimum-contrast, title templates
#   "─── Tabs & splits"   → tab-bar, tab-bar-position, status-bar, split colors
#   "─── Scrolling"       → scrollback, scrollbar, scroll-on-output
#   "─── Selection"       → copy-on-select, mouse-hide-while-typing, word-delimiters
#   "─── Menus"           → vim-menu-nav = true|false (hjkl in menus/overlays)
#   "─── Bell"            → bell = off|visual|attention|both
#   "─── Shell"           → command/shell, login-shell, exit-action
#   "─── Keybind"         → keybind = TRIGGER=ACTION  (Repeatable)
#   "─── SSH"             → ssh-host = name=user@host  (Repeatable)
#   "─── Updates"         → update-check = true|false (in-app new-release banner)
#   "─── Session"         → restore-session = true|false (continue last layout)
#   "─── Agents"          → agent-server, agent-badge (drive kettle from an AI agent)
#   "─── Terminator-parity surface" → window-state, borderless, always-on-top,
#                          background-image, accent-color, light/dark themes,
#                          trigger = REGEX (regex-on-output → window urgency)
#
# Most of the entries above can also be toggled at runtime via right-click
# → Preferences ▸ (cycle-717 submenu); each toggle persists atomically
# back to this file. See docs/CONFIG.md for the full key list.

# ─── Theme ────────────────────────────────────────────────────────────────
# Name from `kettle --list-themes` (500+ bundled — every Ghostty theme).
# The default is Catppuccin Mocha; runtime theme changes (Settings, the Theme
# right-click submenu, Next/PrevTheme) are saved back to this `theme =` line.
# theme = Catppuccin Mocha

# ─── Fonts ────────────────────────────────────────────────────────────────
# font-family = JetBrainsMono Nerd Font
# Per-style overrides (each falls back to `font-family` if unset):
# font-family-bold        = JetBrainsMono Nerd Font Bold
# font-family-italic      = JetBrainsMono Nerd Font Italic
# font-family-bold-italic = JetBrainsMono Nerd Font Bold Italic
# font-size = 13

# OpenType feature toggles. Repeatable; one feature per line or comma-list.
# Forms: `liga` / `+calt` / `-liga` / `liga off` / `cv01=2` / `ss05 3`.
# Toggling any liga/clig/calt/dlig feature also flips the global ligature
# shaper flag (off by default for speed; the toggle re-enables it).
# font-feature = liga
# font-feature = +calt
# font-feature = cv01=2

# ─── Window chrome ───────────────────────────────────────────────────────
# 0.0–1.0; <1.0 needs a compositor on Linux.
# background-opacity   = 1.0
# Gutter px around the content area.
# window-padding-x     = 8
# window-padding-y     = 8
# WCAG contrast ratio (0–21); 0 = off; 4.5 is the AA threshold.
# minimum-contrast     = 0.0

# Transient cols×rows chip during a live window resize (Ghostty parity):
# always | never | after-first (default: every resize except the initial
# window placement).
# resize-overlay = after-first

# Title templates. Placeholders:
#   {title}  active pane's OSC 2/0 title (else "kettle")
#   {cwd}    active pane's cwd basename (else empty)
#   {tab}    1-based active tab index
# window-title-format = {title} — kettle
# tab-format          = {n}: {title}

# ─── Tabs & splits ───────────────────────────────────────────────────────
# off | auto | always
# tab-bar              = always
# top | bottom
# tab-bar-position     = top
# Status bar (iTerm2 / kitty parity). Thin strip at the
# configured edge showing HH:MM:SS UTC · theme · focused pane title.
# off | top | bottom    aliases: none/false=off, on/true=bottom
# status-bar           = off
# 0.1–1.0; dim inactive panes.
# unfocused-split-opacity = 0.7
# Inactive border.
# split-divider-color  = #444444
# Active pane border.
# focused-split-color  = #7aa2f7

# ─── Cursor ──────────────────────────────────────────────────────────────
# block | underline | bar
# cursor-style          = block
# `false` disables blink.
# cursor-style-blink    = true
# Blink half-period in ms; 50–5000.
# cursor-blink-interval = 530
# cursor-color          = #f7768e

# ─── Bell ────────────────────────────────────────────────────────────────
# off | visual | attention | both
# bell = both

# ─── OSC 52 clipboard policy ─────────────────────────────────────────────
# How much of OSC 52 programs in the terminal can use.
# off | copy (writes only — default) | paste | both
# osc52 = copy

# ─── Menus & overlays ────────────────────────────────────────────────────
# Vim-style navigation in kettle's menus/overlays (default on): j/k move,
# g/G first/last, Ctrl+d/Ctrl+u half-page, h back/close, l drill-in/activate,
# y/n in confirm dialogs; text inputs with a selection (palette / search /
# layout picker) use Ctrl+j/Ctrl+k (or Ctrl+n/Ctrl+p) so letters keep typing.
# Mnemonics and type-to-search keep working for non-nav letters.
# Set it to false to restore plain arrow-key navigation.
# vim-menu-nav = true

# ─── Selection & mouse ───────────────────────────────────────────────────
# copy-on-select        = true
# mouse-hide-while-typing = true
# Override the engine default; empty = engine default.
# word-delimiters       = ()[]{}<>
# selection-foreground  = #1a1b26
# selection-background  = #e0af68

# ─── Scrolling ───────────────────────────────────────────────────────────
# `0`/`infinite`/`unlimited` for the cap.
# scrollback              = 10000
# never | auto | always
# scrollbar               = auto
# Jump to bottom on next keystroke.
# scroll-on-keystroke     = true
# Jump to bottom when new output arrives.
# scroll-on-output        = false
# Mouse-wheel speed (0.1–50).
# scroll-multiplier       = 1.0
# Disable Ctrl+wheel font-size change. Keyboard chords still work.
# disable-mousewheel-zoom = false
# Long-command desktop notification: fires when an OSC 133 CommandEnd
# arrives while the kettle window is unfocused and the elapsed time
# crossed this threshold. Requires shell integration. 0 = disabled.
# command-notify-threshold-ms = 5000

# ─── Search overlay ──────────────────────────────────────────────────────
# search-foreground = #1a1b26
# search-background = #e0af68

# ─── Per-color overrides on top of the theme ─────────────────────────────
# background = #1a1b26
# foreground = #c0caf5
# Repeatable: `palette = N=#hex` where N is 0–15 (ANSI 16). Higher
# indices (16–255 xterm 256-color extension) are computed deterministically
# at render time and can be overridden at runtime via OSC 4 from a program,
# but aren't user-settable from the config today — `--check-config` flags
# `palette = N=...` with N ≥ 16 as out-of-range so a typo doesn't dis-
# appear silently.
# palette = 4=#7aa2f7
# palette = 12=#7aa2f7

# ─── Shell / startup command ─────────────────────────────────────────────
# `shell` is an accepted alias.
# command = /usr/bin/fish

# ─── SSH launcher (Ctrl+Shift+S) ─────────────────────────────────────────
# Repeatable. `name=user@host`; name is what shows in the launcher list.
# ssh-host = box=me@box.example.com
# ssh-host = work=wkennedy@bastion.work.example

# ─── Updates ─────────────────────────────────────────────────────────────
# On by default: a quiet once-per-24h check against the GitHub releases API
# that shows a dismissable in-app banner when a newer version ships. It never
# downloads or installs anything. `check-for-updates` is an accepted alias.
# Run `kettle --check-update` to check on demand regardless of this setting.
# (The check is compiled out only in builds made with KETTLE_PACKAGED set —
# for distros that build from source and own their own update channel. The
# prebuilt binaries, incl. the Homebrew/AUR packages that repackage them, do
# check; use `update-check = false` to opt out at runtime.)
# update-check = false

# ─── Session ─────────────────────────────────────────────────────────────
# Restore the previous session (tabs, splits, working dirs) on launch.
# OFF by default — like every mainstream terminal, a new window/instance opens
# fresh (a single pane in the default working directory). Turn this on to
# "continue where you left off", or pass `--restore` for a one-shot restore.
# The session is always saved on exit, so opting in always has state to load.
# restore-session = true

# ─── Agents ──────────────────────────────────────────────────────────────
# Agent control server (off | read-only | full). OFF by default — when
# enabled, lets an AI agent / `kettle ctl` / `kettle mcp` read the screen and
# drive panes over local IPC (Unix socket / Windows named pipe, current-user).
# `read-only` reads/lists; `full` also sends text + runs commands. The
# per-launch override is `kettle --agent-server <mode>`. See docs/AGENT.md.
# agent-server = off
#
# Per-pane titlebar prefix shown while an agent has the pane attached.
# Empty disables it; any glyph works (e.g. `agent-badge = 🤖 `).
# agent-badge = "[agent] "

# ─── Keybindings ─────────────────────────────────────────────────────────
# Full default set: `kettle --list-keybinds`. Override one with:
#   keybind = ctrl+shift+t = new_tab
# Remove a default (let the shell/another tool have the chord) with any of
# the unbind sentinels (`unbind` / `none` / `null` / `false` / empty):
#   keybind = ctrl+shift+c = unbind
# Action names — see docs/CONFIG.md for the full list. Examples:
# keybind = ctrl+shift+f = start_search
# keybind = alt+1        = goto_tab:1
# Ctrl+Shift+1..9 opens the Nth new-tab ▾ dropdown entry by default
# (Windows Terminal's profile shortcuts). Rebind or free the chord:
# keybind = ctrl+shift+1 = new_tab_shell_1
# keybind = ctrl+shift+1 = unbind
# keybind = f1           = about
# The "update available" banner is mouse-driven (left-click opens the release
# page, right-click dismisses). For keyboard access, bind these — they no-op
# when no banner is showing, so the chord is harmless the rest of the time.
# `open_update` opens the release page + dismisses; `dismiss_update` just
# dismisses without opening:
# keybind = ctrl+shift+u = open_update
# keybind = ctrl+shift+x = dismiss_update

# ─── Terminator-parity surface (cycles 331-410) ──────────────────────────
# kettle ships every documented Terminator config key. Both kebab-case
# (kettle convention) and underscore form (Terminator convention) are
# accepted for every key. See docs/TERMINATOR-AUDIT.md for the per-key
# audit.

# NOTE: kettle uses FULL-LINE comments only — a `#` after a value is part of
# that value (so hex colors work), so every option below documents itself on
# its own comment line, with the copy-pasteable `key = value` on the next line.

# Window state at launch. window-state options:
#   maximise | maximize | fullscreen | hidden | normal
# window-state = maximise
# borderless hides the OS chrome (winit set_decorations(false)):
# borderless = true
# Keep the window above all others:
# always-on-top = true
# Quake-style auto-hide on focus loss (Wayland honors the compositor):
# hide-on-lose-focus = true

# Per-pane titlebar (Terminator titlebar.py parity).
# show-titlebar (default true) renders the bar when a tab has more than one pane:
# show-titlebar = true
# Put the title bar at the bottom of the pane instead of the top:
# title-at-bottom = false
# Show the "WxH" size annotation in the titlebar:
# title-hide-sizetext = false
# Bell glyph in the titlebar when the pane rings:
# icon-bell = true
# Titlebar background colors — focused / receiving / idle:
# title-transmit-bg-color = #c80003
# title-receive-bg-color = #0076c9
# title-inactive-bg-color = #c0bebf
# title-transmit-fg-color = #ffffff
# title-receive-fg-color = #ffffff
# title-inactive-fg-color = #000000

# Background (Terminator terminal.py parity + v2.24.0 procedural starfield).
# background-type options: solid (default) / transparent / image / starfield
# A zero-config animated GPU starfield — no file needed (recommended). It's a
# FIXED built-in example: its look (slow drift, star count, glow, fade-in) is
# baked into the shader and is not config-tunable.
# background-type = starfield
# Or use your own image file:
# background-type = image
# background-image = ~/Pictures/wallpaper.jpg
# background-image-mode options: stretch_and_fill (default) / tile / center / scale
# background-image-mode = scale
# background-image-align-horiz options: left / center / right
# background-image-align-horiz = center
# background-image-align-vert options: top / middle / bottom
# background-image-align-vert = middle
# How an ANIMATED background (starfield / GIF / APNG / animated WebP) plays.
# It still freezes when the window is minimized or fully occluded (zero idle).
# background-animation options: always (DEFAULT) / when-focused / off
# background-animation = always
# Opaque chrome (tab/status bar) color over a wallpaper, so the animation never
# bleeds through. options: theme (default) / auto (wallpaper avg) / black / white
# chrome-background = theme
# CPU-side 3-pass box blur at decode:
# background-blur = true
# Tint strength, 0.0 fully dark .. 1.0 no tint:
# background-darkness = 0.5
# Curated, clearly-licensed wallpaper sources + setup: see docs/BACKGROUNDS.md

# Pane text renderer (v2.25.0). grid pins each glyph to its terminal cell
# (Alacritty / kitty / WezTerm / Ghostty style) so fallback glyphs (CJK, color
# emoji, some symbols) and ligatures can't drift off the grid that selection,
# the cursor and mouse hit-testing use. legacy is the pre-2.25.0 continuous
# layout — a rollback escape hatch for isolating renderer regressions.
# Leave it on grid.
# text-renderer options: grid (default) / legacy
# text-renderer = grid

# GPU selection (v2.23.0). kettle renders via wgpu.
# gpu-power-preference options: auto (default; platform/wgpu chooses) / low
#   (low-power, usually integrated) / high (high-performance, often discrete).
# Policy used when no GPU is pinned.
# gpu-power-preference = auto
# Pin a SPECIFIC GPU (easiest via Settings -> Graphics). 0 = use the policy above.
# gpu-vendor-id = 0x10de
# gpu-device-id = 0x2191
# gpu-name = NVIDIA GeForce GTX 1660 Ti
# gpu-backend options: auto (default) / dx12 / vulkan / metal / gl
# gpu-backend = auto
# Force the software renderer (slow; driver-debugging only):
# gpu-force-software = false

# Exit behavior on shell-exit (Terminator config.py).
# exit-action options: close (default) / restart / hold
# exit-action = close

# Mouse / paste behavior.
# Single-click opens URLs (default is Ctrl+click):
# link-single-click = true
# Block middle-click paste:
# disable-mouse-paste = true
# Right-click pastes (PuTTY convention):
# putty-paste-style = true

# Tab UX.
# Hide the close button on tab segments:
# close-button-on-tab = false
# Insert new tabs after the current one (vs append at the end):
# new-tab-after-current-tab = true

# Lua plugin sandbox (~/.config/kettle/init.lua auto-loads).
# lua-sandbox: safe (default) nil's os.execute/io.open; trusted gives full stdlib
# lua-sandbox = safe

# Accent color — the UI chrome accent (active tab, focused-pane border,
# titlebars, drag ghost, menu/settings highlights). The DEFAULT is `auto`
# (since v2.18): Peacock behavior, per WINDOW — each window claims a distinct
# hue from the theme's pool, seeded by the working directory (same project →
# same starting hue) and live-deduped so no two open kettle windows share a
# hue while the pool has a free one. `theme` (also `off`/`none`) opts out —
# every window uses the theme's signature accent (Catppuccin Mocha's mauve,
# matching the app icon). A hex/X11 color pins one color for every window.
# accent-color = auto
# accent-color = theme
# accent-color = #00d4ff

# Silence the bell entirely (Terminator force_no_bell parity).
# Overrides `bell` mode + the visual flash + tray attention.
# force-no-bell = true

# Light/dark theme pair (Terminator auto_theme.py parity).
# `theme-mode = auto` (aliases: `system`, `follow-system`) follows the
# OS appearance preference when winit reports one. Add `theme-schedule`
# to let a clock/sunrise schedule own the switch instead. The
# `toggle_light_dark` action still swaps manually between the same pair.
# Names are case-insensitive bundled-theme names (see
# `kettle --list-themes`); only one of the two needs to be set for a
# one-way switch. If neither is set the action no-ops.
# theme-mode  = auto
# light-theme = TokyoNight Day
# dark-theme  = TokyoNight Night
# theme-schedule = 19:00 dark,07:00 light

# Scrollback search case-sensitivity (Terminator case_sensitive parity).
# kettle defaults to `smart` — case-insensitive until your pattern
# contains an uppercase letter (ripgrep/vim convention). `always`
# forces case-sensitive (Terminator's default), `never` forces
# case-insensitive. The Terminator-spelled `case-sensitive = true/false`
# is also accepted as a shorthand.
# search-case-sensitive = smart
# case-sensitive = true

# Output triggers — regex match on PTY output fires window urgency
# (taskbar/dock attention). Repeatable; `--check-config` reports
# invalid regexes at config-load time. The value is the whole regex
# (do NOT add a second `=` separator).
# trigger = error:.*
# trigger = ssh: connect to host .* port .*: Connection refused
#
# Cycle-622 (Terminator parity, plugins/run_cmd_on_match.py):
# `::` separator extends a trigger to spawn an external program.
# RHS is whitespace-split into argv — kettle does NOT shell-expand
# (security posture: "configured command is data, not shell").
# Fire-and-forget — kettle doesn't wait for the child, doesn't
# capture stdout/stderr, and doesn't track its lifetime.
# trigger = BUILD SUCCESSFUL :: notify-send Build done
# trigger = error.*panic :: /usr/local/bin/oncall-page warn

# ─── Custom right-click menu rows ────────────────────────────────────────
# Repeatable `menu-item = LABEL = CMD`. Each line appends a row to the
# right-click context menu; clicking it writes `CMD\n` to the focused
# pane's PTY. The second `=` is the label/command split — subsequent
# `=` in CMD pass through (so `menu-item = SET = export FOO=bar` works).
# For richer behavior (Lua callbacks, conditional rows) see
# `~/.config/kettle/init.lua` + the cycle-608 example doc.
# menu-item = Clear screen = clear
# menu-item = Edit kettle config = $EDITOR ~/.config/kettle/config
