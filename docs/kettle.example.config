# kettle config — Ghostty-compatible `key = value` syntax.
# Copy to $XDG_CONFIG_HOME/kettle/config (usually ~/.config/kettle/config).
# Full-line comments only; a '#' inside a value (e.g. a hex color) is kept.

theme = TokyoNight Night
font-family = JetBrainsMono Nerd Font
font-size = 13

background-opacity = 1.0
window-padding-x = 8
window-padding-y = 8
cursor-style = block
cursor-style-blink = true
scrollback = 10000

# Override individual colors on top of the theme:
# background = #1a1b26
# foreground = #c0caf5
# palette = 4=#7aa2f7

# Search overlay colors:
# search-foreground = #1a1b26
# search-background = #e0af68

# Rebind anything (trigger=action). Defaults are Terminator-compatible.
# keybind = ctrl+shift+t=new_tab
# keybind = ctrl+shift+o=new_split:right
# keybind = ctrl+shift+f=start_search
