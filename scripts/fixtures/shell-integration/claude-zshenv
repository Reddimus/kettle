# Kettle's .zshenv, which zsh reads in place of yours. It puts ZDOTDIR
# back, runs what Kettle adds, then runs your .zshenv; your other
# startup files follow as usual.
if [[ -n "${KETTLE_ZDOTDIR_SET-}" ]]; then
  ZDOTDIR="${KETTLE_ZDOTDIR-}"
else
  'builtin' 'unset' 'ZDOTDIR'
fi
'builtin' 'unset' 'KETTLE_ZDOTDIR' 'KETTLE_ZDOTDIR_SET'
# Kettle's Claude Code integration (agent-display-claude-code): before your first
# prompt, after all your startup files, define claude unless you have one.
if [[ -o interactive ]]; then
  _kettle_claude() {
    'builtin' 'emulate' -L zsh
    precmd_functions=(${precmd_functions:#_kettle_claude})
    'builtin' 'unfunction' '_kettle_claude'
    if (( ! ${+functions[claude]} )); then
claude() {
  command '/kettle-stand-in/bin/kettle' agent-setup --launch-claude -- "$@"
}
      if (( ${+aliases[claude]} )); then
        'builtin' 'export' KETTLE_OWN_CLAUDE=
      else
        'builtin' 'export' KETTLE_OWN_CLAUDE=0:$$
      fi
    else
      'builtin' 'export' KETTLE_OWN_CLAUDE=1:$$
    fi
  }
  'builtin' 'typeset' -ga precmd_functions
  precmd_functions+=(_kettle_claude)
fi
if [[ -r "${ZDOTDIR-$HOME}/.zshenv" || -r "${ZDOTDIR-$HOME}/.zshenv.zwc" ]]; then
  'builtin' 'source' -- "${ZDOTDIR-$HOME}/.zshenv"
fi
