# typed: strict
# frozen_string_literal: true

# Homebrew formula template for kettle.
#
# The release finalizer renders this file as the `kettle.rb` release asset
# after it has verified the platform archives. Do not install this `.in` file
# directly: its version and SHA-256 values are intentionally unresolved.
#
# To set up a tap so macOS / Linux Homebrew users can install kettle:
#
#   1. Create a public GitHub repo named `homebrew-kettle` under the
#      same org/user as kettle (Homebrew expects the `homebrew-` prefix
#      so `brew tap reddimus/kettle` resolves to `Reddimus/homebrew-
#      kettle`).
#   2. Copy the generated release asset into it as `Formula/kettle.rb`.
#   3. End users then run:
#         brew tap reddimus/kettle
#         brew install kettle
#
# Per-release maintenance is automatic. `render-package-templates.py`
# computes every digest from the verified release inputs and replaces the five
# tokens below. `brew livecheck kettle` still flags tap-repository drift.
#
# This file is a template — it does NOT live in a tap repo yet.
# See `packaging/homebrew/README.md` for the full setup walkthrough.

# Formula for Kettle's signed release manifest and platform binary archives.
class Kettle < Formula
  desc "Fast, cross-platform, GPU-accelerated terminal emulator written in Rust"
  homepage "https://github.com/Reddimus/kettle"
  url "https://github.com/Reddimus/kettle/releases/download/v@VERSION@/kettle-update-manifest.json",
      using: :nounzip
  sha256 "@RELEASE_MANIFEST_SHA256@"
  license "MIT"

  livecheck do
    # `:github_latest` reads the same `/releases/latest` release that
    # `install-online.sh` resolves. Kettle ships one binary per tag and no
    # point releases of older majors, so this is the canonical signal.
    url :stable
    strategy :github_latest
  end

  resource "binary" do
    on_macos do
      # macOS ships the universal2 .app bundle — same binary covers
      # arm64 and x86_64. No need to split by architecture.
      url "https://github.com/Reddimus/kettle/releases/download/v@VERSION@/kettle-macos-universal.zip"
      sha256 "@MACOS_SHA256@"
    end

    on_linux do
      on_arm do
        url "https://github.com/Reddimus/kettle/releases/download/v@VERSION@/kettle-linux-aarch64.tar.gz"
        sha256 "@LINUX_AARCH64_SHA256@"
      end

      on_intel do
        url "https://github.com/Reddimus/kettle/releases/download/v@VERSION@/kettle-linux-x86_64.tar.gz"
        sha256 "@LINUX_X86_64_SHA256@"
      end
    end
  end

  def install
    share_dir = prefix/"share"
    resource("binary").stage do
      if OS.mac?
        # Homebrew stages a single-root archive from inside that root, so the
        # current directory is the extracted `kettle.app` bundle.
        prefix.install Pathname.pwd
        # Symlink the binary inside the .app into bin/ so `kettle` on
        # the user's PATH works after `brew install`. `write_exec_script`
        # would also work but `bin.install_symlink` is the canonical
        # pattern for .app-wrapped CLIs on Homebrew (matches the
        # `macvim`, `ghostty`, etc. formulae).
        bin.install_symlink prefix/"kettle.app/Contents/MacOS/kettle"
      else
        # Homebrew stages the Linux archive from inside its single `kettle/`
        # root, alongside the binary and packaging assets.
        bin.install "kettle"
        man1.install "packaging/linux/kettle.1" if File.exist?("packaging/linux/kettle.1")
        # Install the XDG launcher and icons so Homebrew-on-Linux (Linuxbrew)
        # users also find kettle in GNOME Activities and Ubuntu's Super-key
        # search. `install.sh` uses the same paths relative to its prefix.
        (share_dir/"applications").install "packaging/linux/kettle.desktop"
        (share_dir/"icons/hicolor/scalable/apps").install "packaging/linux/kettle.svg"
        # `kettle-[0-9]*` and not `kettle-*`: the tarball also carries
        # `kettle-light-256.png`, which matches no size and would install into
        # a `hicolor/x/apps` path.
        Dir.glob("packaging/linux/kettle-[0-9]*.png").each do |png|
          size = png[/kettle-(\d+)\.png/, 1]
          (share_dir/"icons/hicolor/#{size}x#{size}/apps").install(png => "kettle.png")
        end
      end
      # Per-platform docs that ship in the release archives (LICENSE,
      # NOTICE, README, CHANGELOG, shell-integration/) — drop them
      # under share/doc so users have an offline reference.
      doc_dir = OS.mac? ? "Contents/Resources" : "."
      %w[LICENSE NOTICE README.md CHANGELOG.md].each do |f|
        next unless File.exist?("#{doc_dir}/#{f}")

        (share_dir/"doc/kettle").install "#{doc_dir}/#{f}"
      end
      if File.directory?("#{doc_dir}/docs/changelog")
        (share_dir/"doc/kettle/docs").install "#{doc_dir}/docs/changelog"
      end
      if File.directory?("#{doc_dir}/shell-integration")
        (share_dir/"doc/kettle").install "#{doc_dir}/shell-integration"
      end
    end
  end

  test do
    # Smoke test: the binary boots, prints its version, and exits
    # cleanly. A git checkout prints `kettle X.Y.Z (sha12)` and a
    # vendored or tarball build prints `kettle X.Y.Z`. Homebrew can bump
    # the formula independently of the upstream release, so match the
    # `kettle X.Y.Z` shape rather than an exact version.
    assert_match(/^kettle [0-9]+\.[0-9]+\.[0-9]+/, shell_output("#{bin}/kettle --version"))
  end
end
